---
import Icon from './Icon.astro';
import { NAV, SITE } from '../data/site';
const buildYear = new Date().getFullYear();
---
<footer class="bg-ink text-white">
  <div class="wrap pb-10 pt-20 lg:pt-28">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <h2 class="heading max-w-[11em]" data-split>Let’s shape your next space</h2>
      <a href="/contact/" class="cta shrink-0 self-start lg:self-auto">
        Start a project
        <span class="cta-icon"><Icon name="arrow-right" size={16} /></span>
      </a>
    </div>

    <div class="mt-16 grid gap-10 border-t border-white/15 pt-10 sm:grid-cols-2 lg:mt-24 lg:grid-cols-[1.6fr_1fr_1.2fr_1.2fr]">
      <a href="/" class="inline-flex w-fit rounded-[6px]" aria-label="Adash Architects, home">
        <img src="/images/brand/logo-horizontal-white.png" alt="" width="903" height="319" loading="lazy" class="h-10 w-auto" />
      </a>
      <nav aria-label="Footer">
        <h2 class="eyebrow text-white/55">Menu</h2>
        <ul class="mt-4 space-y-1">
          {NAV.map((item) => <li><a href={item.href} class="inline-block rounded-[4px] py-1 hover:underline underline-offset-4">{item.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="eyebrow text-white/55">Office</h2>
        <address class="mt-5 not-italic text-white/85">
          {SITE.name}<br />{SITE.address.street}, {SITE.address.city}<br />{SITE.address.region}, {SITE.address.country}
        </address>
      </div>
      <div>
        <h2 class="eyebrow text-white/55">Get in touch</h2>
        <ul class="mt-4 space-y-1">
          <li><a href={SITE.phoneHref} class="inline-block rounded-[4px] py-1 hover:underline underline-offset-4">{SITE.phoneDisplay}</a></li>
          <li><a href={`mailto:${SITE.email}`} class="inline-block rounded-[4px] py-1 break-all hover:underline underline-offset-4">{SITE.email}</a></li>
        </ul>
      </div>
    </div>

    <p class="mt-14 flex flex-wrap justify-between gap-3 border-t border-white/15 pt-6 text-[12px] uppercase tracking-[0.04em] text-white/55">
      <span>© <span data-year>{buildYear}</span> {SITE.name}</span>
      <span>{SITE.address.city}, {SITE.address.region}</span>
    </p>
  </div>
</footer>
<script is:inline>
  document.querySelectorAll('[data-year]').forEach(function (el) { el.textContent = new Date().getFullYear(); });
</script>
