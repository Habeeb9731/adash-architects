---
import CardPanel from './CardPanel.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { siteImages } from '../data/projects';

// Wording comes from the live site's About page.
const services = [
  { icon: 'pencil-ruler', title: 'Concept development', text: 'Client meetings and concept development that listen, understand, and translate your aspirations into design.' },
  { icon: 'layers', title: 'Interiors & facades', text: 'Interiors and facades that reflect character and clarity.' },
  { icon: 'hard-hat', title: 'Execution & coordination', text: 'Execution and coordination on-site, with honest design and practical solutions at each stage of the process.' },
];
---
<CardPanel
  id="services-heading"
  heading="What we do"
  label="What Adash Architects does"
  pill={{ label: 'Explore', ariaLabel: 'Explore our projects', href: '/projects/' }}
  tagline="Thoughtful, detail-driven design."
  items={services}
>
  <li slot="lead" data-slide class="panel-card relative flex snap-start flex-col">
    <span class="notch notch-tl" style="--notch: var(--panel-bg);"><Icon name="building" size={16} /></span>
    <div class="relative">
      <div class="relative h-[200px] overflow-hidden rounded-[14px] bg-line">
        <Photo image={siteImages.services} sizes="380px" frameAspect={1.7} />
        <span class="photo-shade absolute inset-0"></span>
        <h3 class="absolute inset-x-4 bottom-4 text-[26px] leading-[1.1] text-white">Architecture &amp; renovation</h3>
      </div>
      <span class="notch notch-tr" style="--notch: #fff;"></span>
    </div>
    <div class="mt-auto pt-8">
      <span class="block h-px w-6 bg-ink"></span>
      <p class="mt-4 text-sm text-muted">Designs that not only look good but also serve people better, preserving heritage while infusing modern functionality.</p>
    </div>
  </li>
</CardPanel>

<style>
  .photo-shade {
    background: linear-gradient(to bottom, rgb(8 44 92 / 0) 25%, rgb(8 44 92 / 0.74) 62%);
  }
</style>
