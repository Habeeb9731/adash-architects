---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  href?: string;
  sizes: string;
  headingLevel?: 'h2' | 'h3';
}
const { project, href, sizes, headingLevel: Heading = 'h3' } = Astro.props;
const Wrapper = href ? 'a' : 'div';
---
<Wrapper href={href} class="group block rounded-[var(--radius-img)]">
  <div class="zoom relative aspect-[4/5] overflow-hidden rounded-[var(--radius-img)] bg-line">
    <Photo image={project.image} sizes={sizes} frameAspect={0.8} />
    <span class="absolute right-3 top-3 z-[2] rounded-[8px] bg-white px-2.5 py-1 text-xs text-ink">{project.type}</span>
    <div class="absolute inset-x-3 bottom-3 z-[2] flex items-center justify-between gap-3 rounded-[12px] bg-white p-3 pl-4">
      <Heading class="min-h-9 content-center text-[17px] leading-[1.2] tracking-[-0.02em]">{project.name}</Heading>
      {href && (
        <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-[8px] bg-sand text-ink transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transform-none">
          <Icon name="arrow-up-right" size={16} />
        </span>
      )}
    </div>
  </div>
</Wrapper>
