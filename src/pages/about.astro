---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { CORE_VALUES, FOUNDER_NAME, FOUNDER_TITLE } from '../data/site';
import portrait from '../assets/shafeeqIcon.png';
---
<Base
  title="About Us | ADASH ARCHITECTS"
  description={`Meet Adash Architects and founder and principal architect ${FOUNDER_NAME}. Our philosophy is architecture that is functional, sustainable and connected to its environment.`}
>
  <section class="wrap pb-14 pt-10 lg:pb-20 lg:pt-20">
    <p class="eyebrow">About</p>
    <h1 class="display mt-4">About Us</h1>
  </section>

  <section class="wrap grid gap-8 pb-[72px] lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-6 lg:pb-[120px]">
    <h2 class="text-sm tracking-normal text-muted lg:pt-2">Our philosophy</h2>
    <div data-reveal>
      <p class="statement [text-wrap:pretty]">Welcome to ADASH ARCHITECTS, where innovative design meets thoughtful execution. We are a passionate team dedicated to transforming visions into tangible, inspiring spaces. Our philosophy centers on creating architecture that is not only aesthetically pleasing but also functional, sustainable, and deeply connected to its environment and the people who inhabit it.</p>
      <p class="mt-8 max-w-[62ch] text-muted">With years of experience in diverse projects, from residential masterpieces to commercial landmarks, we pride ourselves on our meticulous attention to detail, creative problem-solving, and a collaborative approach with our clients. We believe that great architecture is a dialogue, and we strive to listen, understand, and translate your aspirations into designs that exceed expectations.</p>
    </div>
  </section>

  <section class="section border-y border-line text-center" aria-labelledby="values-heading">
    <div class="wrap">
      <h2 id="values-heading" class="heading" data-reveal>Our Core Values</h2>
      <ul class="mx-auto mt-14 grid max-w-[1180px] grid-cols-1 gap-10 sm:grid-cols-2 lg:mt-20 lg:grid-cols-5 lg:gap-8" data-reveal>
        {CORE_VALUES.map((value) => (
          <li class="flex flex-col items-center">
            <span class="tile"><Icon name={value.icon} /></span>
            <h3 class="mt-5 text-[17px] tracking-[-0.02em]">{value.title}</h3>
            <p class="mt-2 max-w-[30ch] text-sm text-muted">{value.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="founder-heading">
    <div class="wrap grid items-start gap-10 md:grid-cols-[minmax(0,360px)_minmax(0,1fr)] md:gap-16 lg:gap-24">
      <div class="md:sticky md:top-8" data-reveal>
        <Image
          src={portrait}
          alt={`Portrait of ${FOUNDER_NAME}`}
          widths={[320, 500]}
          sizes="(min-width: 768px) 360px, 90vw"
          format="webp"
          loading="lazy"
          class="aspect-square w-full max-w-[360px] rounded-[var(--radius-img)] object-cover"
        />
      </div>
      <div class="max-w-[64ch]" data-reveal>
        <h2 id="founder-heading" class="heading">{FOUNDER_NAME}</h2>
        <p class="mt-3 text-muted">{FOUNDER_TITLE}</p>
        <div class="mt-8 space-y-5 text-[17px] leading-[1.6]">
          <p>I’m {FOUNDER_NAME}, the founder and principal architect of Adash Architects. With a strong vision to create meaningful spaces rooted in both functionality and aesthetics, I established Adash Architects to bring thoughtful, detail-driven design to life—especially for communities that value authenticity and innovation.</p>
          <p>A graduate in architecture with hands-on experience from Archi Technics Firm in Mangalore, I began my journey working on high-rise residential buildings and complex urban projects. This gave me the technical foundation and creative confidence to take the next step: launching my own firm.</p>
          <p>Adash Architects was born out of that passion—to craft designs that not only look good but also serve people better. From leading a hospital renovation project in my hometown to designing interiors and facades that reflect character and clarity, I’ve had the opportunity to handle each stage of the process—from client meetings and concept development to execution and coordination on-site.</p>
          <p>At Adash Architects, every project is a chance to connect with people, solve problems creatively, and contribute something lasting to the built environment. My commitment lies in honest design, practical solutions, and a deep respect for the craft of architecture.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section !pt-0 text-center" data-reveal>
    <div class="wrap">
      <p class="statement mx-auto max-w-[24em]">At ADASH ARCHITECTS, we don’t just design buildings; we craft experiences. Let us help you build your dream.</p>
      <a href="/contact/" class="btn mt-8">Start a project</a>
    </div>
  </section>
</Base>
