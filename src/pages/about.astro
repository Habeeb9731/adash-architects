---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
import { siteImages } from '../data/projects';
import { CORE_VALUES, FOUNDER_NAME, FOUNDER_TITLE } from '../data/site';
import portrait from '../assets/shafeeqIcon.png';

const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="About Us | ADASH ARCHITECTS"
  description={`Meet Adash Architects and founder and principal architect ${FOUNDER_NAME}. Our philosophy is architecture that is functional, sustainable and connected to its environment.`}
  overHero
>
  <PageHero
    image={siteImages.aboutHero}
    title="About us"
    label="Our studio"
    intro="Where innovative design meets thoughtful execution."
    focus="50% 60%"
  />

  <!-- Philosophy -->
  <section class="section" aria-labelledby="philosophy-heading">
    <div class="wrap">
      <div class="flex items-start justify-between gap-6" data-reveal>
        <h2 id="philosophy-heading" class="heading max-w-[14em]" data-split><span class="inline-block w-[1.1em]" aria-hidden="true"></span>Architecture that is functional, sustainable and connected —</h2>
        <p class="eyebrow mt-2 hidden shrink-0 sm:block">Our philosophy</p>
      </div>

      <div class="mt-12 grid gap-8 lg:mt-16 lg:grid-cols-12 lg:items-end lg:gap-6" data-reveal>
        <div class="zoom relative aspect-[4/5] overflow-hidden rounded-[8px] bg-line lg:col-span-4 lg:col-start-5" data-img-reveal>
          <Photo image={siteImages.pairSmall} sizes="(min-width: 1024px) 32vw, 92vw" frameAspect={0.8} />
        </div>
        <div class="space-y-5 text-[15px] leading-relaxed text-muted lg:col-span-4 lg:pl-4">
          <p>Welcome to ADASH ARCHITECTS, where innovative design meets thoughtful execution. We are a passionate team dedicated to transforming visions into tangible, inspiring spaces. Our philosophy centers on creating architecture that is not only aesthetically pleasing but also functional, sustainable, and deeply connected to its environment and the people who inhabit it.</p>
          <p>With years of experience in diverse projects, from residential masterpieces to commercial landmarks, we pride ourselves on our meticulous attention to detail, creative problem-solving, and a collaborative approach with our clients. We believe that great architecture is a dialogue, and we strive to listen, understand, and translate your aspirations into designs that exceed expectations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core values -->
  <section class="section bg-[#f3f2ee]" aria-labelledby="values-heading">
    <div class="wrap">
      <div class="flex items-start justify-between gap-6" data-reveal>
        <h2 id="values-heading" class="heading" data-split>Our core values</h2>
        <p class="eyebrow mt-2 hidden shrink-0 sm:block">What guides us</p>
      </div>
      <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:mt-16 lg:grid-cols-5" data-stagger>
        {CORE_VALUES.map((value, i) => (
          <li class="flex min-h-[260px] flex-col rounded-[10px] bg-white p-5">
            <div class="flex items-center justify-between">
              <span class="text-[12px] text-muted" aria-hidden="true">[{pad(i + 1)}]</span>
              <span class="inline-flex size-10 items-center justify-center rounded-full bg-ink text-white"><Icon name={value.icon} /></span>
            </div>
            <h3 class="mt-auto pt-10 text-[22px] uppercase leading-none tracking-[-0.04em]">{value.title}</h3>
            <p class="mt-3 text-[13px] leading-relaxed text-muted">{value.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Founder -->
  <section class="section" aria-labelledby="founder-heading">
    <div class="wrap">
      <div class="flex items-start justify-between gap-6" data-reveal>
        <h2 id="founder-heading" class="heading" data-split>{FOUNDER_NAME}</h2>
        <p class="eyebrow mt-2 hidden shrink-0 sm:block">The founder</p>
      </div>
      <p class="mt-4 text-muted" data-reveal>{FOUNDER_TITLE}</p>

      <div class="mt-12 grid items-start gap-10 md:grid-cols-12 md:gap-6 lg:mt-16">
        <div class="max-w-[360px] overflow-hidden rounded-[8px] md:sticky md:top-28 md:col-span-4" data-img-reveal>
          <Image
            src={portrait}
            alt={`Portrait of ${FOUNDER_NAME}`}
            widths={[320, 500]}
            sizes="(min-width: 768px) 360px, 90vw"
            format="webp"
            loading="lazy"
            class="aspect-[4/5] w-full max-w-[360px] rounded-[8px] object-cover"
          />
        </div>
        <div class="space-y-5 text-[17px] leading-[1.6] md:col-span-7 md:col-start-6" data-reveal>
          <p>I’m {FOUNDER_NAME}, the founder and principal architect of Adash Architects. With a strong vision to create meaningful spaces rooted in both functionality and aesthetics, I established Adash Architects to bring thoughtful, detail-driven design to life—especially for communities that value authenticity and innovation.</p>
          <p>A graduate in architecture with hands-on experience from Archi Technics Firm in Mangalore, I began my journey working on high-rise residential buildings and complex urban projects. This gave me the technical foundation and creative confidence to take the next step: launching my own firm.</p>
          <p>Adash Architects was born out of that passion—to craft designs that not only look good but also serve people better. From leading a hospital renovation project in my hometown to designing interiors and facades that reflect character and clarity, I’ve had the opportunity to handle each stage of the process—from client meetings and concept development to execution and coordination on-site.</p>
          <p>At Adash Architects, every project is a chance to connect with people, solve problems creatively, and contribute something lasting to the built environment. My commitment lies in honest design, practical solutions, and a deep respect for the craft of architecture.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing statement -->
  <section class="section !pt-0">
    <div class="wrap border-t border-line pt-12 lg:pt-16">
      <p class="heading max-w-[16em]" data-split>We don’t just design buildings; we craft experiences.</p>
    </div>
  </section>
</Base>
