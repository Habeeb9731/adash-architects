---
import Icon from './Icon.astro';

interface Item { icon: string; title: string; text: string }
interface Props {
  id: string;
  heading: string;
  eyebrow?: string;
  /** Names the carousel for screen readers, e.g. "core values". */
  label: string;
  pill: { label: string; ariaLabel: string; href: string };
  tagline: string;
  items: readonly Item[];
}
const { id, heading, eyebrow, label, pill, tagline, items } = Astro.props;
---
<section class="card-panel mx-2 rounded-[20px] py-14 sm:mx-3 lg:py-20" aria-labelledby={id}>
  <div class="panel-inset" data-reveal>
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h2 id={id} class="display flex items-center gap-3">
      <span>{heading}</span>
      <Icon name="corner-right-down" size={40} class="mt-3 hidden shrink-0 sm:block" />
    </h2>
  </div>

  <div data-carousel role="group" aria-roledescription="carousel" aria-label={label} class="panel-grid mt-8 grid gap-8 lg:mt-12 lg:gap-6" data-reveal>
    <div class="panel-inset flex flex-col justify-between gap-8 lg:!pr-0">
      <a href={pill.href} class="pill" aria-label={pill.ariaLabel}>
        {pill.label}
        <Icon name="arrow-up-right" size={16} />
      </a>
      <p class="hidden max-w-[22ch] text-sm text-muted lg:block lg:pb-[72px]">{tagline}</p>
    </div>

    <div class="min-w-0">
      <ul
        data-track
        data-focusable
        aria-label={`${label}, scrollable`}
        class="panel-track no-scrollbar flex snap-x snap-mandatory items-stretch gap-3 overflow-x-auto py-1 lg:gap-4"
      >
        <slot name="lead" />
        {items.map((item) => (
          <li data-slide class="panel-card flex snap-start flex-col">
            <h3 class="text-[22px] leading-[1.15]">{item.title}</h3>
            <div class="mt-auto pt-8">
              <span class="block h-px w-6 bg-ink"></span>
              <p class="mt-4 text-sm text-muted">{item.text}</p>
              <span class="mt-6 inline-flex size-10 items-center justify-center rounded-full bg-sand"><Icon name={item.icon} /></span>
            </div>
          </li>
        ))}
      </ul>

      <div data-controls class="panel-inset mt-5 flex items-center justify-between lg:!pl-0">
        <div class="flex gap-1">
          <button type="button" data-prev class="arrow" aria-label="Previous card" aria-disabled="true"><Icon name="arrow-left" size={20} /></button>
          <button type="button" data-next class="arrow" aria-label="Next card"><Icon name="arrow-right" size={20} /></button>
        </div>
        <div class="flex gap-2" aria-hidden="true">
          {[0, 1, 2].map(() => <span data-segment class="segment"></span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/carousel';
</script>

<style is:global>
  .card-panel {
    --panel-bg: #f1f0ec;
    --inset: 8px;
    /* Lines the panel's content up with the page's content column. */
    --edge: max(calc(var(--gutter) - var(--inset)), calc((100vw - var(--inset) * 2 - 1320px) / 2));
    background: var(--panel-bg);
  }
  @media (min-width: 640px) { .card-panel { --inset: 12px; } }
  .panel-inset { padding-inline: var(--edge); }

  .panel-track {
    padding-inline: var(--edge);
    scroll-padding-inline: var(--edge);
  }
  @media (min-width: 1024px) {
    .panel-grid { grid-template-columns: calc(var(--edge) + 240px) minmax(0, 1fr); }
    .panel-track { padding-left: 0; scroll-padding-left: 0; }
  }

  .panel-card {
    width: min(80vw, 340px);
    min-height: 300px;
    flex-shrink: 0;
    padding: 16px;
    border-radius: 18px;
    background: #fff;
  }
  @media (min-width: 1024px) { .panel-card { width: 380px; padding: 20px; } }

  .pill {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 22px;
    min-height: 40px;
    padding: 0 12px 0 16px;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    font-size: 14px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .pill:hover { background: var(--color-ink); color: #fff; }

  .arrow {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    color: var(--color-ink);
  }
  .arrow:hover { background: rgb(17 18 20 / 0.06); }
  .arrow[aria-disabled='true'] { color: #8d8d89; background: none; cursor: default; }

  .segment {
    display: block;
    width: 30px;
    height: 2px;
    background: #cfcec8;
    transition: background-color 0.2s ease;
  }
  .segment[data-active] { background: var(--color-ink); }

  /* Cut-out corners, with concave edges drawn by radial gradients. */
  .notch {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: var(--notch);
  }
  .notch::before, .notch::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
  }
  .notch-tl { top: 0; left: 0; border-bottom-right-radius: 16px; }
  .notch-tl::before, .notch-tl::after { background: radial-gradient(circle at 100% 100%, transparent 15.5px, var(--notch) 16px); }
  .notch-tl::before { top: 0; left: 100%; }
  .notch-tl::after { top: 100%; left: 0; }
  .notch-tr { top: -1px; right: -1px; border-bottom-left-radius: 16px; }
  .notch-tr::before, .notch-tr::after { background: radial-gradient(circle at 0 100%, transparent 15.5px, var(--notch) 16px); }
  .notch-tr::before { top: 0; right: 100%; }
  .notch-tr::after { top: 100%; right: 0; }

  @media (prefers-reduced-motion: reduce) {
    .pill, .segment { transition: none; }
  }
</style>
