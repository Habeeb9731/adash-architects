---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
import { projects, siteImages } from '../data/projects';

const types = [...new Set(projects.map((p) => p.type))];
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="Our Projects | ADASH ARCHITECTS"
  description="Explore a selection of innovative architectural designs by Adash Architects, across healthcare, commercial, civic, hospitality, renovation and mixed-use work."
  overHero
>
  <PageHero
    image={siteImages.projectsHero}
    title="Our projects"
    label="Selected work"
    intro="Explore a selection of our innovative architectural designs and completed projects."
    focus="60% 40%"
  >
    <a href="#project-list" class="cta mt-8">
      See the work
      <span class="cta-icon"><Icon name="arrow-right" size={16} class="rotate-90" /></span>
    </a>
  </PageHero>

  <!-- Overview -->
  <section class="section !pb-0" aria-labelledby="overview-heading">
    <div class="wrap">
      <div class="flex items-start justify-between gap-6" data-reveal>
        <h2 id="overview-heading" class="heading max-w-[13em]" data-split><span class="inline-block w-[1.1em]" aria-hidden="true"></span>Spaces for living, working and gathering</h2>
        <p class="eyebrow mt-2 hidden shrink-0 sm:block">{pad(projects.length)} projects</p>
      </div>
      <ul class="mt-12 flex flex-wrap gap-2" aria-label="Project types" data-stagger>
        {types.map((t) => <li class="rounded-full border border-line px-4 py-2 text-[12px] uppercase tracking-[0.04em]">{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- Project list -->
  <section id="project-list" class="section scroll-mt-24" aria-label="Project list">
    <ol class="wrap space-y-20 lg:space-y-32">
      {projects.map((project, i) => {
        const flip = i % 2 === 1;
        return (
          <li id={project.slug} class="scroll-mt-28 grid items-end gap-6 border-t border-line pt-6 md:grid-cols-12 md:gap-6" data-reveal>
            <div class:list={['zoom relative aspect-[4/3] overflow-hidden rounded-[8px] bg-line md:col-span-7', flip && 'md:order-2 md:col-start-6']} data-img-reveal>
              <Photo image={project.image} sizes="(min-width: 768px) 56vw, 92vw" />
            </div>
            <div class:list={['md:col-span-4', flip ? 'md:order-1 md:col-start-1' : 'md:col-start-9']}>
              <p class="text-[12px] text-muted">[{pad(i + 1)}] · <span class="uppercase tracking-[0.04em]">{project.type}</span></p>
              <h2 class="mt-4 text-[clamp(1.75rem,3vw,2.75rem)] uppercase leading-[0.98] tracking-[-0.045em]">{project.name}</h2>
              {project.description && <p class="mt-5 max-w-[40ch] text-[14px] leading-relaxed text-muted">{project.description}</p>}
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</Base>
