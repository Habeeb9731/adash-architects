---
import lightbulb from 'lucide-static/icons/lightbulb.svg?raw';
import leaf from 'lucide-static/icons/leaf.svg?raw';
import users from 'lucide-static/icons/users.svg?raw';
import gem from 'lucide-static/icons/gem.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import building from 'lucide-static/icons/building-2.svg?raw';
import layers from 'lucide-static/icons/layers.svg?raw';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import pencilRuler from 'lucide-static/icons/pencil-ruler.svg?raw';
import hardHat from 'lucide-static/icons/hard-hat.svg?raw';
import cornerRightDown from 'lucide-static/icons/corner-right-down.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';

const icons: Record<string, string> = {
  lightbulb, leaf, users, gem, 'shield-check': shieldCheck, building, layers,
  'arrow-left': arrowLeft, 'arrow-right': arrowRight, 'arrow-up-right': arrowUpRight, menu, x,
  'pencil-ruler': pencilRuler, 'hard-hat': hardHat, 'corner-right-down': cornerRightDown,
};

interface Props { name: string; size?: number; class?: string }
const { name, size = 18, class: className = '' } = Astro.props;
const raw = icons[name];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw
  .replace(/<!--[\s\S]*?-->\s*/g, '')
  .replace(/class="[^"]*"/, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, 'stroke-width="1.6"')
  .replace('<svg', `<svg aria-hidden="true" focusable="false" class="${className}"`);
---
<Fragment set:html={svg} />
