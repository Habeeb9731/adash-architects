---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base
  title="Contact Us | ADASH ARCHITECTS"
  description="Contact Adash Architects in Maril, Puttur, Karnataka. Call +91 9480364510 or email info@adasharchitects.com about your project."
>
  <section class="wrap pb-14 pt-10 lg:pb-24 lg:pt-20">
    <p class="eyebrow">Contact</p>
    <h1 class="display mt-4">Contact Us</h1>
    <p class="statement mt-8 max-w-[28em] text-muted [text-wrap:pretty]">We’d love to hear from you! Whether you have a project in mind, a question, or just want to say hello, feel free to reach out.</p>
  </section>
  <section class="wrap pb-[72px] lg:pb-[120px]">
    <div class="grid gap-10 border-t border-line pt-10 md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] md:gap-6 lg:pt-14">
      <div>
        <h2 class="text-sm tracking-normal text-muted">Our Office</h2>
        <address class="mt-4 text-[22px] not-italic leading-[1.3] tracking-[-0.02em]">
          {SITE.name}<br />{SITE.address.street}<br />{SITE.address.city}<br />{SITE.address.region}, {SITE.address.country}
        </address>
      </div>
      <div>
        <h2 class="text-sm tracking-normal text-muted">Get in Touch</h2>
        <ul class="mt-4 space-y-3">
          <li><a href={SITE.phoneHref} class="statement text-link inline-block rounded-[4px]">{SITE.phoneDisplay}</a></li>
          <li><a href={`mailto:${SITE.email}`} class="statement text-link inline-block break-all rounded-[4px]">{SITE.email}</a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
