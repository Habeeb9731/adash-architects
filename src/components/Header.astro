---
import Icon from './Icon.astro';
import { NAV } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
---
<!-- A floating dark pill, centred at the top of every page. -->
<header data-header class="site-header pointer-events-none fixed inset-x-0 top-3 z-40 flex justify-center px-4 sm:top-4">
  <div class="pointer-events-auto relative">
    <div class="nav-pill flex items-center gap-2 rounded-full py-1.5 pl-5 pr-1.5 text-white">
      <a href="/" class="inline-flex shrink-0 items-center rounded-[6px]" aria-label="Adash Architects, home">
        <img src="/images/brand/logo-horizontal-white.png" alt="" width="903" height="319" class="h-7 w-auto" />
      </a>

      <nav aria-label="Primary" class="hidden md:block">
        <ul class="ml-6 mr-3 flex items-center gap-1 text-[12.5px] uppercase tracking-[0.04em]">
          {NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
                class="block rounded-full px-3 py-2 text-white/75 transition-colors hover:text-white aria-[current=page]:text-white aria-[current=page]:bg-white/12"
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <a href="/contact/" class="hidden size-9 items-center justify-center rounded-full bg-white text-ink md:inline-flex" aria-label="Start a project">
        <Icon name="arrow-up-right" size={17} />
      </a>

      <button
        type="button"
        class="group ml-4 inline-flex size-9 items-center justify-center rounded-full bg-white text-ink md:hidden"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span class="inline-flex group-aria-expanded:hidden"><Icon name="menu" size={18} /></span>
        <span class="hidden group-aria-expanded:inline-flex"><Icon name="x" size={18} /></span>
      </button>
    </div>

    <div
      id="mobile-nav"
      hidden
      class="nav-pill absolute left-1/2 top-[calc(100%+8px)] w-[min(calc(100vw-32px),340px)] -translate-x-1/2 rounded-[22px] p-3 text-white md:hidden"
    >
      <nav aria-label="Mobile">
        <ul>
          {NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
                class="block rounded-[12px] px-3 py-3 text-[22px] uppercase tracking-[-0.03em] hover:bg-white/10 aria-[current=page]:bg-white/12"
              >{item.label}</a>
            </li>
          ))}
        </ul>
        <a href="/contact/" class="cta mt-3 w-full justify-between">
          Start a project
          <span class="cta-icon"><Icon name="arrow-right" size={16} /></span>
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Drops in on load, hides while scrolling down, and always shows when it has keyboard focus. */
  .site-header { transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease; }
  :global(.js) .site-header { opacity: 0; transform: translateY(-24px); }
  :global(.js.is-loaded) .site-header { opacity: 1; transform: none; transition-delay: 0.15s; }
  :global(.js.is-loaded) .site-header:global(.is-hidden) { opacity: 0; transform: translateY(-150%); transition-delay: 0s; }
  :global(.js.is-loaded) .site-header:focus-within { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .site-header { transition: none; opacity: 1; transform: none; }
  }
  .nav-pill {
    background: rgb(17 18 20 / 0.62);
    border: 1px solid rgb(255 255 255 / 0.14);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 12px 40px -16px rgb(0 0 0 / 0.45);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    const set = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    toggle.addEventListener('click', () => set(panel.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { set(false); toggle.focus(); }
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!panel.hidden && !panel.contains(t) && !toggle.contains(t)) set(false);
    });
  }
</script>
